        "partitions": [
          {
            "name": "KPI Scorecard",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database),",
                "    Data = Source{[Schema=\"analytics\",Item=\"kpi_scorecard\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KPI Value",
            "expression": "MAX('KPI Scorecard'[value])",
            "lineageTag": "d928d22c-f41a-5674-82e9-a9d7ca26c816",
            "formatString": "#,0.####"
          },
          {
            "name": "KPI Display",
            "expression": [
              "VAR v = [KPI Value]",
              "VAR u = SELECTEDVALUE('KPI Scorecard'[unit])",
              "VAR txt = SWITCH(u, \"%\", FORMAT(v, \"0.0%\"), \"pts\", FORMAT(v * 100, \"0.0\") & \" pts\",",
              "    \"$\", IF(v >= 10000, FORMAT(v, \"$#,0\"), FORMAT(v, \"$#,0.00\")), \"min\", FORMAT(v, \"0.0\") & \" min\",",
              "    \"x\", FORMAT(v, \"0.00\") & \"x\", FORMAT(v, \"#,0\"))",
              "RETURN IF(ISBLANK(v), BLANK(), txt & \"  \" & SELECTEDVALUE('KPI Scorecard'[status_icon]))"
            ],
            "lineageTag": "62c74222-1686-51b5-99b7-41dce2509436"
          },
          {
            "name": "KPI Change vs LY",
            "expression": [
              "VAR c = MAX('KPI Scorecard'[change_vs_ly])",
              "VAR u = SELECTEDVALUE('KPI Scorecard'[unit])",
              "RETURN IF(ISBLANK(c), BLANK(), IF(u IN {\"%\", \"pts\"}, FORMAT(c * 100, \"+0.0;-0.0\") & \" pts\", FORMAT(c, \"+0.0%;-0.0%\")))"
            ],
            "lineageTag": "44fc7c0e-89c0-56c7-9de9-8a042a0dd77d"
          },
          {
            "name": "KPI Status Color",
            "expression": "SWITCH(SELECTEDVALUE('KPI Scorecard'[status]), \"good\", \"#0A7D0A\", \"warning\", \"#D98A00\", \"critical\", \"#B3261E\", \"#7A8784\")",
            "lineageTag": "228a1d10-2c22-515d-ae57-1331df35515e"
          },
          {
            "name": "Critical KPIs",
            "expression": "CALCULATE(COUNTROWS('KPI Scorecard'), 'KPI Scorecard'[status] = \"critical\")",
            "lineageTag": "8e1bf6f6-b92f-5854-8fb0-6501ebe1b068",
            "formatString": "#,0"
          },
          {
            "name": "KPIs on Target",
            "expression": "CALCULATE(COUNTROWS('KPI Scorecard'), 'KPI Scorecard'[status] = \"good\")",
            "lineageTag": "cbba5f14-6096-5094-a0ae-f1997fd01bcd",
            "formatString": "#,0"
          }
        ]
      },
