        "measures": [
          {
            "name": "P&L Net Sales",
            "expression": "SUM('Monthly P&L'[net_sales])",
            "lineageTag": "acbb9e7e-49d4-5032-b139-39c2d1c85049",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "P&L"
          },
          {
            "name": "P&L COGS",
            "expression": "SUM('Monthly P&L'[total_cogs])",
            "lineageTag": "b1c2fa5c-4d88-5630-80b5-274b41caa5a1",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "P&L"
          },
          {
            "name": "P&L Labor",
            "expression": "SUM('Monthly P&L'[labor_cost])",
            "lineageTag": "b703da6b-c52c-5ea5-ade0-7ef6c9547676",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "P&L"
          },
          {
            "name": "P&L Operating Expenses",
            "expression": "SUM('Monthly P&L'[opex])",
            "lineageTag": "aeac2da5-2fe6-5462-9d61-dd590558d74c",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "P&L"
          },
          {
            "name": "Four-Wall EBITDA",
            "expression": "SUM('Monthly P&L'[four_wall_ebitda])",
            "lineageTag": "6ee2fc42-b0e4-5a14-8013-7aa57faed20a",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "P&L"
          },
          {
            "name": "EBITDA Margin",
            "expression": "DIVIDE([Four-Wall EBITDA], [P&L Net Sales])",
            "lineageTag": "d29c7d5b-7f1e-5d65-ba2e-90048d001412",
            "formatString": "0.0%",
            "displayFolder": "P&L"
          },
          {
            "name": "Occupancy %",
            "expression": "DIVIDE(SUM('Monthly P&L'[rent]), [P&L Net Sales])",
            "lineageTag": "7ac7524f-6f07-5855-87b0-3577939ab57d",
            "formatString": "0.0%",
            "displayFolder": "P&L"
          },
          {
            "name": "EBITDA Margin Status",
            "expression": "VAR v = [EBITDA Margin] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v >= 0.17, \"Healthy\", v >= 0.12, \"Thin\", \"Weak\")",
            "lineageTag": "06938cac-7c21-5f77-8e33-ba37e50bfcef",
            "displayFolder": "Status"
          },
          {
            "name": "EBITDA Margin Color",
            "expression": "VAR v = [EBITDA Margin] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v >= 0.17, \"#0A7D0A\", v >= 0.12, \"#D98A00\", \"#B3261E\")",
            "lineageTag": "b8436666-bdc1-54ae-96c5-4edb5f52d0ee",
            "displayFolder": "Status"
          }
        ]
      },
