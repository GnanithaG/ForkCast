        "measures": [
          {
            "name": "Sales Today",
            "expression": "SUM('Live Today'[sales_today])",
            "lineageTag": "0e80c223-1dc8-5cc4-99f2-3977bb2c36ff",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
