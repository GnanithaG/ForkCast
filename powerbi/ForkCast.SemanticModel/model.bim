        "partitions": [
          {
            "name": "OKR Board",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database),",
                "    Data = Source{[Schema=\"analytics\",Item=\"okr_board\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KR Progress",
            "expression": "MAX('OKR Board'[progress])",
            "lineageTag": "c03bbadb-2d40-5693-a2f7-b9f51aa8b2b0",
            "formatString": "0%"
          },
          {
            "name": "KR Progress (0-100%)",
            "expression": "MAX(0, MIN(1, [KR Progress]))",
            "lineageTag": "7c7d03a7-82b7-5db1-ab4b-b3405f675847",
            "formatString": "0%"
          },
          {
            "name": "Objective Progress",
            "expression": "AVERAGEX(VALUES('OKR Board'[kr_id]), MAX(0, MIN(1, CALCULATE(MAX('OKR Board'[progress])))))",
            "lineageTag": "c7b03208-eff8-5b88-897e-a91809f85455",
            "formatString": "0%"
          },
          {
            "name": "KRs On Track",
            "expression": "CALCULATE(DISTINCTCOUNT('OKR Board'[kr_id]), 'OKR Board'[status] = \"on track\")",
            "lineageTag": "4423a3f5-4a0e-526c-80f2-f0f89b320243",
            "formatString": "#,0"
          },
          {
            "name": "KRs At Risk",
            "expression": "CALCULATE(DISTINCTCOUNT('OKR Board'[kr_id]), 'OKR Board'[status] = \"at risk\")",
            "lineageTag": "e553b08c-66db-5d90-b3ea-cdbb908b8e51",
            "formatString": "#,0"
          },
          {
            "name": "KRs Off Track",
            "expression": "CALCULATE(DISTINCTCOUNT('OKR Board'[kr_id]), 'OKR Board'[status] = \"off track\")",
            "lineageTag": "4ab85cc1-ab18-57dd-b319-9eacff20fea5",
            "formatString": "#,0"
          },
          {
            "name": "KR Baseline",
            "expression": [
              "VAR v = MAX('OKR Board'[baseline]) VAR u = SELECTEDVALUE('OKR Board'[unit])",
              "RETURN IF(ISBLANK(v), BLANK(), SWITCH(u, \"%\", FORMAT(v, \"0.0%\"), \"pts\", FORMAT(v * 100, \"0.0\") & \" pts\", \"$\", FORMAT(v, \"$#,0.00\"), \"min\", FORMAT(v, \"0.0\") & \" min\", FORMAT(v, \"#,0.00\")))"
            ],
            "lineageTag": "75a14745-0a83-534d-894e-c5f83b614d4f"
          },
          {
            "name": "KR Target",
            "expression": [
              "VAR v = MAX('OKR Board'[target]) VAR u = SELECTEDVALUE('OKR Board'[unit])",
              "RETURN IF(ISBLANK(v), BLANK(), SWITCH(u, \"%\", FORMAT(v, \"0.0%\"), \"pts\", FORMAT(v * 100, \"0.0\") & \" pts\", \"$\", FORMAT(v, \"$#,0.00\"), \"min\", FORMAT(v, \"0.0\") & \" min\", FORMAT(v, \"#,0.00\")))"
            ],
            "lineageTag": "455d4a7b-4f87-54f9-a5a7-2acf51104ec8"
          },
          {
            "name": "KR Current",
            "expression": [
              "VAR v = MAX('OKR Board'[current_value]) VAR u = SELECTEDVALUE('OKR Board'[unit])",
              "RETURN IF(ISBLANK(v), BLANK(), SWITCH(u, \"%\", FORMAT(v, \"0.0%\"), \"pts\", FORMAT(v * 100, \"0.0\") & \" pts\", \"$\", FORMAT(v, \"$#,0.00\"), \"min\", FORMAT(v, \"0.0\") & \" min\", FORMAT(v, \"#,0.00\")))"
            ],
            "lineageTag": "8c9e57b8-333f-58f8-a713-1691441d84d6"
          },
          {
            "name": "KR Status Color",
            "expression": "SWITCH(SELECTEDVALUE('OKR Board'[status]), \"on track\", \"#0A7D0A\", \"at risk\", \"#D98A00\", \"off track\", \"#B3261E\", \"#7A8784\")",
            "lineageTag": "00867e64-6e01-5d95-b81b-02d8f02afa37"
          }
        ]
      },
