        ],
        "partitions": [
          {
            "name": "Daily Location",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database),",
                "    Data = Source{[Schema=\"analytics\",Item=\"daily_location\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Net Sales",
            "expression": "SUM('Daily Location'[net_sales])",
            "lineageTag": "144d7311-60f9-5881-be70-da12e7fbd4fc",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Gross Sales",
            "expression": "SUM('Daily Location'[gross_sales])",
            "lineageTag": "2e59031f-b9ca-5e32-a683-c3a00cce401e",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Total Covers",
            "expression": "SUM('Daily Location'[covers])",
            "lineageTag": "793249ba-2373-5353-8b17-82d4576afcf1",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Total Checks",
            "expression": "SUM('Daily Location'[checks])",
            "lineageTag": "81d273a0-f5cc-5cea-8974-029ece0cbac1",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Average Check",
            "expression": "DIVIDE([Net Sales], [Total Checks])",
            "lineageTag": "9a1982a6-bff5-5ce3-a4df-71112662afd6",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Revenue"
          },
          {
            "name": "Sales per Cover",
            "expression": "DIVIDE([Net Sales], [Total Covers])",
            "lineageTag": "da30d2d6-4cd6-5e56-8746-b0dcdbf375a2",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Revenue"
          },
          {
            "name": "Dine-in Sales",
            "expression": "SUM('Daily Location'[dine_in_sales])",
            "lineageTag": "9f0ae2aa-aa65-5231-bec0-0eb87bccb857",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Takeout Sales",
            "expression": "SUM('Daily Location'[takeout_sales])",
            "lineageTag": "b97f4b62-8d96-5f45-afcb-fd48169b9c1b",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Delivery Sales",
            "expression": "SUM('Daily Location'[delivery_sales])",
            "lineageTag": "62253fb6-8d9b-5da5-8fb2-6210795db990",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Off-Premise Share",
            "expression": "DIVIDE([Takeout Sales] + [Delivery Sales], [Net Sales])",
            "lineageTag": "334435b6-e9e0-5735-b808-79990b4a8e0b",
            "formatString": "0.0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "Lunch Sales",
            "expression": "SUM('Daily Location'[lunch_sales])",
            "lineageTag": "0c34d42b-ce34-516d-8b63-e94b7cf88aa4",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Dinner Sales",
            "expression": "SUM('Daily Location'[dinner_sales])",
            "lineageTag": "7926020e-b930-51ba-a8cd-47a1b4297d7a",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Net Sales LY",
            "expression": "CALCULATE([Net Sales], DATEADD('Date'[date], -364, DAY))",
            "lineageTag": "d66b340e-dc26-578e-a8e7-29837147f1d2",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Net Sales vs LY %",
            "expression": "DIVIDE([Net Sales] - [Net Sales LY], [Net Sales LY])",
            "lineageTag": "23f18ceb-20ee-5b75-aad5-109c72bde1c9",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "Covers LY",
            "expression": "CALCULATE([Total Covers], DATEADD('Date'[date], -364, DAY))",
            "lineageTag": "eb1bc1dc-9ed5-561a-b50e-390f36d6498e",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Covers vs LY %",
            "expression": "DIVIDE([Total Covers] - [Covers LY], [Covers LY])",
            "lineageTag": "34076ce6-75c4-54bf-b40d-68469187367c",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "Seat Utilization",
            "expression": "DIVIDE(SUM('Daily Location'[occupied_seat_min]), SUM('Daily Location'[available_seat_min]))",
            "lineageTag": "21ef9712-1039-566b-9cf3-668efdcb2b64",
            "formatString": "0.0%",
            "displayFolder": "Floor"
          },
          {
            "name": "RevPASH",
            "expression": "DIVIDE([Dine-in Sales], DIVIDE(SUM('Daily Location'[available_seat_min]), 60))",
            "lineageTag": "3c3435a0-2413-5a6c-8a7a-fcf2ce5bffa3",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Floor"
          },
          {
            "name": "Table Turns per Day",
            "expression": "DIVIDE(SUM('Daily Location'[dine_in_checks]), SUM('Daily Location'[tables]))",
            "lineageTag": "2d2bb7b6-9e16-5770-b39c-2c6ba7cfa9ff",
            "formatString": "#,0.00",
            "displayFolder": "Floor"
          },
          {
            "name": "Avg Dwell (min)",
            "expression": "DIVIDE(SUM('Daily Location'[dwell_min_total]), SUM('Daily Location'[dine_in_checks]))",
            "lineageTag": "ea6be5a5-d0da-5a71-87a6-a8f651ee80ae",
            "formatString": "#,0.0",
            "displayFolder": "Floor"
          },
          {
            "name": "Lost Covers",
            "expression": "SUM('Daily Location'[lost_covers])",
            "lineageTag": "d68384a6-31fa-51ef-8434-e34db499d063",
            "formatString": "#,0",
            "displayFolder": "Floor"
          },
          {
            "name": "Walk-away Rate",
            "expression": "DIVIDE(SUM('Daily Location'[lost_parties]), SUM('Daily Location'[dine_in_checks]) + SUM('Daily Location'[lost_parties]))",
            "lineageTag": "e5c41adc-5f23-5a5b-9ecc-84f695a8f022",
            "formatString": "0.0%",
            "displayFolder": "Floor"
          },
          {
            "name": "Large-Party Walk-away Rate",
            "expression": "DIVIDE(SUM('Daily Location'[lost_large_parties]), SUM('Daily Location'[dine_large_parties]) + SUM('Daily Location'[lost_large_parties]))",
            "lineageTag": "0e3ec20d-a89a-5d35-bc86-5e5bd1aa1157",
            "formatString": "0.0%",
            "displayFolder": "Floor"
          },
          {
            "name": "Lost Sales (est.)",
            "expression": "[Lost Covers] * [Sales per Cover]",
            "lineageTag": "ee250b06-3bbd-5099-b635-7c2c0839c6ad",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Floor"
          },
          {
            "name": "Avg Wait (min)",
            "expression": "DIVIDE(SUM('Daily Location'[wait_min_total]), SUM('Daily Location'[parties_waited]))",
            "lineageTag": "6a534b86-c1d9-53cc-affa-1352586210e7",
            "formatString": "#,0.0",
            "displayFolder": "Floor"
          },
          {
            "name": "Labor Cost",
            "expression": "SUM('Daily Location'[labor_cost])",
            "lineageTag": "00596055-deb1-56c3-b18b-897785e33776",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Labor"
          },
          {
            "name": "Labor Hours",
            "expression": "SUM('Daily Location'[labor_hours])",
            "lineageTag": "9ae0e5ba-716b-591f-8d09-ba6d41a65b7f",
            "formatString": "#,0",
            "displayFolder": "Labor"
          },
          {
            "name": "Labor %",
            "expression": "DIVIDE([Labor Cost], [Net Sales])",
            "lineageTag": "e79e5f42-3579-513d-a490-7fc4cca5b9de",
            "formatString": "0.0%",
            "displayFolder": "Labor"
          },
          {
            "name": "Labor % LY",
            "expression": "CALCULATE([Labor %], DATEADD('Date'[date], -364, DAY))",
            "lineageTag": "101a3ff2-14d3-5799-93d8-73e4ea26858a",
            "formatString": "0.0%",
            "displayFolder": "Labor"
          },
          {
            "name": "Sales per Labor Hour",
            "expression": "DIVIDE([Net Sales], [Labor Hours])",
            "lineageTag": "a9180617-9b58-54b8-b70f-09dd29737ee0",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Labor"
          },
          {
            "name": "Covers per Labor Hour",
            "expression": "DIVIDE([Total Covers], [Labor Hours])",
            "lineageTag": "b7c68cb2-6afc-5968-96bf-2f6bfffcae20",
            "formatString": "#,0.00",
            "displayFolder": "Labor"
          },
          {
            "name": "Food Sales",
            "expression": "SUM('Daily Location'[food_sales])",
            "lineageTag": "d115a2fd-d293-5e16-86c8-a50b9ec97a1b",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "Food Purchases",
            "expression": "SUM('Daily Location'[purchases_food])",
            "lineageTag": "beae0a00-b59d-553d-902a-e4f412af1207",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "Food Cost %",
            "expression": "DIVIDE([Food Purchases], [Food Sales])",
            "lineageTag": "bb654fe8-bda2-575f-ba04-fdec62d2ee92",
            "formatString": "0.0%",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "Recipe Food Cost %",
            "expression": "DIVIDE(SUM('Daily Location'[theoretical_food_cost]), [Food Sales])",
            "lineageTag": "8938478d-6782-5ef4-a468-33ea6fc207b7",
            "formatString": "0.0%",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "Food Cost Variance (pts)",
            "expression": "([Food Cost %] - [Recipe Food Cost %]) * 100",
            "lineageTag": "286dc9c4-71ea-536d-bcd8-a833c7bc979e",
            "formatString": "0.0",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "Beverage Cost %",
            "expression": "DIVIDE(SUM('Daily Location'[purchases_bev]), SUM('Daily Location'[beverage_sales]))",
            "lineageTag": "68c5d2aa-9c50-598d-aa84-3dc92c375798",
            "formatString": "0.0%",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "COGS",
            "expression": "SUM('Daily Location'[purchases_food]) + SUM('Daily Location'[purchases_bev]) + SUM('Daily Location'[purchases_packaging])",
            "lineageTag": "a4e73810-856a-57bb-bff2-23f6e6bc3261",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "Waste Cost",
            "expression": "SUM('Daily Location'[waste_cost])",
            "lineageTag": "d8744f31-12d7-55d7-8af9-a8e798cd0276",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "Waste %",
            "expression": "DIVIDE([Waste Cost], [Food Purchases])",
            "lineageTag": "6a9e4a69-48f9-59ca-a987-e0b2717292bd",
            "formatString": "0.0%",
            "displayFolder": "Cost of goods"
          },
          {
            "name": "Prime Cost",
            "expression": "[COGS] + [Labor Cost]",
            "lineageTag": "f9d85b09-5f3c-582e-8bc8-6685954c6529",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Profit"
          },
          {
            "name": "Prime Cost %",
            "expression": "DIVIDE([Prime Cost], [Net Sales])",
            "lineageTag": "20186688-4352-5fb4-9fc4-cbca10bd463d",
            "formatString": "0.0%",
            "displayFolder": "Profit"
          },
          {
            "name": "Prime Cost % LY",
            "expression": "CALCULATE([Prime Cost %], DATEADD('Date'[date], -364, DAY))",
            "lineageTag": "2f12528d-1d74-55ee-bc94-626a547bbcd5",
            "formatString": "0.0%",
            "displayFolder": "Profit"
          },
          {
            "name": "Discount Rate",
            "expression": "DIVIDE(SUM('Daily Location'[discounts]), [Gross Sales])",
            "lineageTag": "7ee1979b-6461-593c-b5cf-7ef271720ef2",
            "formatString": "0.0%",
            "displayFolder": "Profit"
          },
          {
            "name": "Delivery Commissions (est.)",
            "expression": "SUM('Daily Location'[delivery_commission_est])",
            "lineageTag": "3039b7c4-99f0-5ac4-9d5d-3edf5f100ea0",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Profit"
          },
          {
            "name": "Prime Cost % Status",
            "expression": "VAR v = [Prime Cost %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v <= 0.65, \"On target\", v <= 0.68, \"Watch\", \"Over\")",
            "lineageTag": "f39a1b38-9b1e-53c4-85c5-8e480fdc25ce",
            "displayFolder": "Status"
          },
          {
            "name": "Prime Cost % Color",
            "expression": "VAR v = [Prime Cost %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v <= 0.65, \"#0A7D0A\", v <= 0.68, \"#D98A00\", \"#B3261E\")",
            "lineageTag": "c07cb1ed-01fd-5fe6-b26b-da4af4600c79",
            "displayFolder": "Status"
          },
          {
            "name": "Labor % Status",
            "expression": "VAR v = [Labor %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v <= 0.32, \"On target\", v <= 0.35, \"Watch\", \"Over\")",
            "lineageTag": "0d8b4103-e6b2-5ae3-9762-240ea0ceea78",
            "displayFolder": "Status"
          },
          {
            "name": "Labor % Color",
            "expression": "VAR v = [Labor %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v <= 0.32, \"#0A7D0A\", v <= 0.35, \"#D98A00\", \"#B3261E\")",
            "lineageTag": "2873ab6a-bb98-5e48-bae5-bd9769de1e8b",
            "displayFolder": "Status"
          },
          {
            "name": "Food Cost % Status",
            "expression": "VAR v = [Food Cost %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v <= 0.33, \"On target\", v <= 0.35, \"Watch\", \"Over\")",
            "lineageTag": "4ffeb1a4-6866-5604-a37d-b7faa9fd3059",
            "displayFolder": "Status"
          },
          {
            "name": "Food Cost % Color",
            "expression": "VAR v = [Food Cost %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v <= 0.33, \"#0A7D0A\", v <= 0.35, \"#D98A00\", \"#B3261E\")",
            "lineageTag": "598ce6ea-88ad-5af0-9b58-93126a11779f",
            "displayFolder": "Status"
          },
          {
            "name": "Waste % Status",
            "expression": "VAR v = [Waste %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v <= 0.045, \"On target\", v <= 0.06, \"Watch\", \"High\")",
            "lineageTag": "fa25dbf4-533f-5492-bb70-2c3b59e9e331",
            "displayFolder": "Status"
          },
          {
            "name": "Waste % Color",
            "expression": "VAR v = [Waste %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v <= 0.045, \"#0A7D0A\", v <= 0.06, \"#D98A00\", \"#B3261E\")",
            "lineageTag": "d695886a-5c4f-53ad-84db-05dd1a44dbc5",
            "displayFolder": "Status"
          }
        ]
      },
      {
