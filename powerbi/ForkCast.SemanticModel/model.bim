            "lineageTag": "210b4c1d-df3f-53ce-a9d9-eab7c9c77362",
            "formatString": "0.0%"
          },
          {
            "name": "Within Band %",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('Forecast vs Actual'), 'Forecast vs Actual'[within_band] = TRUE()), COUNTROWS('Forecast vs Actual'))",
            "lineageTag": "42f1fb6b-336f-5ad9-b2b5-2c8c110bc6c9",
            "formatString": "0%"
          }
        ]
      },
