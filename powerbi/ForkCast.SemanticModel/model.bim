              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Hourly Actual Sales",
            "expression": "SUM('Live Hourly'[sales])",
            "lineageTag": "995c6ed0-f5d0-59e6-92dc-857b932cb438",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Hourly Expected Sales",
            "expression": "SUM('Live Hourly'[expected_sales])",
            "lineageTag": "0ccb6e1b-1e4f-5e9e-ac73-c1c166d2046d",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Expected Sales Today",
            "expression": "SUM('Live Hourly'[expected_sales])",
            "lineageTag": "d61c7f24-c7b3-558f-bb87-0a58bad5bb11",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Sales vs Pace %",
            "expression": [
              "VAR a = CALCULATE(SUM('Live Hourly'[sales]), 'Live Hourly'[is_settled] = TRUE())",
              "VAR e = CALCULATE(SUM('Live Hourly'[expected_sales]), 'Live Hourly'[is_settled] = TRUE())",
              "RETURN DIVIDE(a - e, e)"
            ],
            "lineageTag": "ea2168a4-eb68-5266-bf93-204743376141",
            "formatString": "+0%;-0%;0%"
          }
        ]
      },
