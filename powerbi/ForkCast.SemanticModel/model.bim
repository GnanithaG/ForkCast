        "partitions": [
          {
            "name": "Hourly Floor",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database),",
                "    Data = Source{[Schema=\"analytics\",Item=\"hourly_floor\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Hourly Seat Utilization",
            "expression": "DIVIDE(SUM('Hourly Floor'[occupied_seat_min]), SUM('Hourly Floor'[available_seat_min]))",
            "lineageTag": "a1573cf5-3b43-541b-b550-55f03344ee44",
            "formatString": "0%",
            "displayFolder": "Floor by hour"
          },
          {
            "name": "Hourly RevPASH",
            "expression": "DIVIDE(SUM('Hourly Floor'[dine_sales]), DIVIDE(SUM('Hourly Floor'[available_seat_min]), 60))",
            "lineageTag": "cd8e66b0-5d81-5f63-9bf9-7f9bf11c362a",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "displayFolder": "Floor by hour"
          },
          {
            "name": "Hourly Sales",
            "expression": "SUM('Hourly Floor'[net_sales])",
            "lineageTag": "8e7bbebd-4c12-5fc8-8dbc-371032108af2",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Floor by hour"
          },
          {
            "name": "Hourly Covers",
            "expression": "SUM('Hourly Floor'[covers])",
            "lineageTag": "25ca0526-a3cc-59c8-acbd-35e14a782249",
            "formatString": "#,0",
            "displayFolder": "Floor by hour"
          },
          {
            "name": "Hourly Lost Parties",
            "expression": "SUM('Hourly Floor'[lost_parties])",
            "lineageTag": "33eda606-c52e-5970-8eae-11b426494f36",
            "formatString": "#,0",
            "displayFolder": "Floor by hour"
          },
          {
            "name": "Staff Hours",
            "expression": "SUM('Hourly Floor'[staff_hours])",
            "lineageTag": "d0bca96d-0044-5307-8f9a-674407d73968",
            "formatString": "#,0.0",
            "displayFolder": "Floor by hour"
          },
          {
            "name": "Covers per Staff Hour",
            "expression": "DIVIDE([Hourly Covers], [Staff Hours])",
            "lineageTag": "56efee4e-4318-5534-a9e5-b59deb108b01",
            "formatString": "#,0.00",
            "displayFolder": "Floor by hour"
          }
        ]
      },
